<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="SuplementiDB"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=SuplementiDB;Integrated Security=True;TrustServerCertificate=True"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="ip" value="127.0.0.1" />
    <add key="port" value="9999" />
  </appSettings>
</configuration>
